
#include <stdio.h>

int main()
{
    char text[100];
    int key, i;

    printf("Enter the message: ");
    scanf("%99[^\n]", text);

    printf("Enter the key (1-25): ");
    scanf("%d", &key);

    if (key < 1 || key > 25)
    {
        printf("Invalid key!");
        return 0;
    }

    for (i = 0; text[i] != '\0'; i++)
    {
        if (text[i] >= 'A' && text[i] <= 'Z')
        {
            text[i] = (text[i] - 'A' + key) % 26 + 'A';
        }
        else if (text[i] >= 'a' && text[i] <= 'z')
        {
            text[i] = (text[i] - 'a' + key) % 26 + 'a';
        }
    }

    printf("Encrypted message: %s\n", text);

    return 0;
}

